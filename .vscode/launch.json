{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Backend API)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/dist/index.js",
      "preLaunchTask": "build:server",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "PORT": "5050",
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Client in Chrome (Frontend)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Server + Client)",
      "configurations": ["Debug Server (Backend API)", "Launch Client in Chrome (Frontend)"]
    }
  ]
}
