{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server (Port 5050)",
      "type": "shell",
      "command": "node dist/index.js",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Bizpoa POS Backend API Server Running",
          "endsPattern": "Bizpoa POS Backend API Server Running"
        }
      },
      "presentation": {
        "group": "bizpoa-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Client (Port 3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "group": "bizpoa-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build:server",
      "type": "shell",
      "command": "npx tsc",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build:client",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
